# Giảm build context — Dockerfile.dev chỉ cần pom.xml + src/, Dockerfile (production) chỉ cần file jar.
# Dùng `target/*` + `!target/*.jar` thay cho `target/` vì Docker không cho "bỏ loại trừ" file nằm
# trong thư mục đã bị loại cả thư mục.
target/*
!target/*.jar
.git
.gitignore
.env
.env.*
!.env.example

# Tài liệu không cần trong image
*.md
docker-compose.yml

# IDE
.idea/
*.iml
.vscode/
.settings/
.project
.classpath

# Log & OS
logs/
*.log
.DS_Store
Thumbs.db
