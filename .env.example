# =====================================================================
# AI-Powered LMS — Biến môi trường
#
# Cách dùng:  cp .env.example .env   rồi điền giá trị.
# TUYỆT ĐỐI KHÔNG commit file .env (đã có trong .gitignore).
#
# Ở Giai đoạn 0 chỉ cần JWT_SECRET là bắt buộc; các khoá API bên thứ ba
# để trống vẫn khởi động được, sẽ điền khi tới giai đoạn dùng đến.
# =====================================================================

# ── BẮT BUỘC ở Giai đoạn 0 ─────────────────────────────
# Chuỗi ngẫu nhiên >= 32 ký tự. Sinh nhanh:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# ── MySQL ──────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=lms_db
# App dùng user riêng, không dùng root
MYSQL_USER=lms_user
MYSQL_PASSWORD=lms_pass

# ── Cổng (đổi nếu bị chiếm) ────────────────────────────
FRONTEND_PORT=3000
BACKEND_PORT=8080
AI_API_PORT=8000
ADMINER_PORT=8081
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
MYSQL_PORT=3306
REDIS_PORT=6379

# ── Spring ─────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev

# ── JWT — thời hạn theo BR-AUTH-04 ─────────────────────
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ── Token nội bộ: AI Worker gọi callback về backend ────
INTERNAL_API_TOKEN=dev-internal-token

# =====================================================================
# GIAI ĐOẠN 5 — Pipeline lồng tiếng AI
# Phần thuộc ai-worker (ASR/LLM/TTS/tham số pipeline/Supabase RAG) đã
# chuyển sang project/ai-worker/.env.example — be chỉ giữ phần be tự dùng.
# =====================================================================
DUB_LOCK_TTL_SECONDS=1800            # BR-DUB-05 — khóa Redis chống trùng job

# ── Hạn ngạch nghiệp vụ ────────────────────────────────
QUOTA_DUB_STUDENT_PER_DAY=15        # BR-DUB-06
QUOTA_DUB_INSTRUCTOR_PER_DAY=30     # BR-DUB-06
QUOTA_MATERIAL_PER_DAY=6            # BR-MAT-08
QUOTA_TUTOR_MSG_PER_DAY=30          # BR-TUTOR-04
QUOTA_DISCOVERY_GUEST_PER_HOUR=15   # BR-DISCOVERY-01

# =====================================================================
# GIAI ĐOẠN 4 — Lưu trữ file (Backblaze B2 + Cloudflare CDN)
# be tự dùng cho video/tài liệu/ảnh bìa. ai-worker cũng cần — xem
# project/ai-worker/.env.example (bản sao cố ý, bí mật hạ tầng dùng chung).
# =====================================================================
B2_BUCKET_NAME=
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_ENDPOINT=

# =====================================================================
# GIAI ĐOẠN 3 — Cổng thanh toán (đều dùng Sandbox)
# =====================================================================
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
